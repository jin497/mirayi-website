  "testimonial_by": "Chey I IL Woong, Director — Aurora World",
  "rebate_title": "30% cash rebate for animation produced in Malaysia",
  "testimonial_quote": "Mirayi completed and delivered the best 3D animation with integrity and zeal. Well done!"
